<?xml version="1.0" encoding="UTF-8"?>
<!-- Fetches the OpenTelemetry Java agent, pinned in the parent, so every image ships the same one (ADR 5).
     Author: Ignacio Rodriguez Caro <rnachoccontact@gmail.com> -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.rnachoc.mercadillo</groupId>
    <artifactId>mercadillo</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>otel-agent</artifactId>
  <packaging>pom</packaging>

  <dependencies>
    <dependency>
      <groupId>io.opentelemetry.javaagent</groupId>
      <artifactId>opentelemetry-javaagent</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-agent</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <includeArtifactIds>opentelemetry-javaagent</includeArtifactIds>
              <outputDirectory>${project.build.directory}</outputDirectory>
              <stripVersion>true</stripVersion>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
