# Local configuration for GuardiAI. `make up` copies this file to .env when .env is missing.
# Every value is a local-only placeholder: Mercadillo is fictional, and nothing here unlocks
# anything outside your machine. Never put a real credential in this file.

# Mercadillo's database. It is reachable only inside the Compose network.
POSTGRES_DB=mercadillo
POSTGRES_USER=mercadillo
POSTGRES_PASSWORD=local-only-placeholder

# Grafana's admin account, at http://127.0.0.1:3000. Anyone on this machine can view without it.
GRAFANA_ADMIN_PASSWORD=local-only-placeholder

# How many synthetic shoppers arrive each second.
SHOPPERS_PER_SECOND=4

# Model provider, read by the agents from Phase 4 on.
# "fake" replays recorded responses: it needs no key and spends nothing.
# "anthropic" calls the real API and needs ANTHROPIC_API_KEY.
GUARDIA_MODEL_PROVIDER=fake
ANTHROPIC_API_KEY=

# Hard cap, in US dollars, on what real model runs may spend. A run aborts when it is reached.
GUARDIA_MAX_SPEND_USD=1.00

# A Slack-style incoming webhook that GuardiAI calls when a remediation fails and needs a person.
# Empty uses the local mock, which shows them at http://127.0.0.1:8091.
GUARDIA_ESCALATION_WEBHOOK_URL=
