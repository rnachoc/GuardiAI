root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,md,html,css,js,jsx,ts,tsx,toml,xml}]
indent_size = 2

# Shell scripts, including the git hooks, which have no extension.
[*.sh]
indent_size = 2

[.githooks/*]
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[LICENSE]
indent_size = unset
