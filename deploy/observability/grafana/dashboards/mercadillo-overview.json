          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"gateway\", http_route=~\"/api/.*\"}[$__rate_interval]))) * 1000",
          "legendFormat": "__auto",
          "range": true,
          "instant": false
